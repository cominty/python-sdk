# Example environment for the Cominty SDK.
#
# The SDK reads these from the real process environment. It does NOT auto-load
# .env: either export them, or load this file yourself, e.g.:
#   set -a; source .env; set +a                       # shell
#   from dotenv import load_dotenv; load_dotenv()      # python-dotenv (not a dependency)

# Your API key (required). Create one at https://platform.cominty.ai/api-keys
COMINTY_API_KEY=

# End-user identifier (required): the user every request acts on behalf of.
# Looks like user_xxxxxxxxxxxxxxxxxxxxxxxx. Find yours at
# https://platform.cominty.ai -> avatar (top right) -> Profile
COMINTY_USER_ID=

# --- Optional ------------------------------------------------------------
# Override the API base URL (default: https://ds.cominty.com).
#   dev -> https://ds-dev.cominty.com
# COMINTY_BASE_URL=https://ds-dev.cominty.com

# Used only by the example scripts (the SDK itself has no agent default).
# Find agent ids at https://platform.cominty.ai/agents
# COMINTY_AGENT_ID=__cominty_agents::agent.chat
# A custom agent you created on the platform, used by 07_custom_agent.py
# COMINTY_CUSTOM_AGENT_ID=

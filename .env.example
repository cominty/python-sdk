# Copy to .env — the SDK loads it automatically (no python-dotenv needed).
#   cp .env.example .env

# --- Chat (API access token mode) ---------------------------------------
# API access token created via POST /api-tokens (see README "Authentication").
COMINTY_API_KEY=
# End-user identifier. REQUIRED in API token mode (e.g. user_123).
COMINTY_USER_ID=

# --- Optional overrides --------------------------------------------------
# Pick an environment: dev | staging | production (default: production)
COMINTY_ENVIRONMENT=production
# Or override the base URL directly (takes precedence over COMINTY_ENVIRONMENT):
#   dev        -> https://ds-dev.cominty.com
#   staging    -> https://api.staging.cominty.com
#   production -> https://ds.cominty.com
# COMINTY_API_URL=https://ds.cominty.com
# Default agent pid (default: __cominty_agents::agent.chat)
# COMINTY_AGENT_ID=__cominty_agents::agent.chat
# COMINTY_MAX_RETRIES=3
# COMINTY_TIMEOUT=60

# --- Admin (token management / GET /agents) ------------------------------
# Clerk session JWT — only for POST/GET/DELETE /api-tokens and GET /agents.
# COMINTY_SESSION_TOKEN=
# COMINTY_ORG_ID=
